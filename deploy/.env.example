# AegisGate Environment Configuration

# Server
AEGIS_ENV=prod
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8000
AEGIS_LOG_LEVEL=INFO

# Security
AEGIS_SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-in-production
AEGIS_JWT_ALGORITHM=HS256
AEGIS_JWT_EXPIRY_MINUTES=1440

# Database
# Production PostgreSQL:
DATABASE_URL=postgresql+asyncpg://aegis_user:aegis_pass@postgres:5432/aegisgate
# Local SQLite for testing/standalone:
# DATABASE_URL=sqlite+aiosqlite:///./aegisgate.db

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=aegisgate:

# OpenTelemetry & Prometheus
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_METRICS_ENABLED=true

# Local ML & Judge Endpoints
LOCAL_ONNX_MODEL_DIR=/app/models
LLM_JUDGE_BASE_URL=http://localhost:11434/v1
LLM_JUDGE_API_KEY=ollama
LLM_JUDGE_MODEL=llama3.2

