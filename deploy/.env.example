# AegisGate Environment Configuration

# Server
AEGIS_ENV=prod
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8088
AEGIS_LOG_LEVEL=INFO

# Security
AEGIS_SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-in-production
AEGIS_JWT_ALGORITHM=HS256
AEGIS_JWT_EXPIRY_MINUTES=1440

# Database
# Production PostgreSQL:
DATABASE_URL=postgresql+asyncpg://aegis_user:aegis_pass@postgres:5432/aegisgate
# Local SQLite for testing/standalone:
# DATABASE_URL=sqlite+aiosqlite:///./aegisgate.db

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=aegisgate:

# OpenTelemetry & Prometheus
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_METRICS_ENABLED=true

# Local ML & Judge Endpoints
LOCAL_ONNX_MODEL_DIR=/app/models
AEGIS_MODEL_DIR=/app/models
LLM_JUDGE_BASE_URL=http://localhost:11434/v1
LLM_JUDGE_API_KEY=ollama
LLM_JUDGE_MODEL=llama3.2

# Upstream LLM Pools & Failover
AEGIS_UPSTREAM_URLS=https://api.openai.com/v1

# Enterprise KMS & Cryptography
KMS_PROVIDER=local
AEGIS_KMS_PROVIDER=local
AEGIS_KMS_KEY_ID=
AEGIS_KMS_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AEGIS_KMS_ACTIVE_VERSION=v1

# Outbound SSRF Protection & Scanner Bounds
AEGIS_SSRF_ALLOWLIST_CIDRS=
MAX_PAYLOAD_SCAN_BYTES=1048576
MAX_JSON_DEPTH=20

# Enterprise OIDC SSO
OIDC_ENABLED=false
OIDC_ISSUER=https://auth.company.internal/
OIDC_CLIENT_ID=aegisgate-portal
OIDC_JWKS_URI=https://auth.company.internal/.well-known/jwks.json
OIDC_ROLE_CLAIM=groups

